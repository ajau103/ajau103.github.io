<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Find Your Next Vehicle | AutoDrive</title>
  <meta name="description" content="Explore quality vehicles and get personalized assistance finding the right vehicle for your needs. Contact AutoDrive today.">

  <style>
    :root {
      --primary: #111827;
      --primary-light: #1f2937;
      --accent: #e63946;
      --accent-dark: #c92f3b;
      --white: #ffffff;
      --light: #f5f6f8;
      --text: #5b6470;
      --border: #e3e6ea;
      --success: #18794e;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      color: var(--primary);
      background: var(--white);
      line-height: 1.6;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    /* =========================
       HEADER
    ========================= */

    header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(255,255,255,0.98);
      border-bottom: 1px solid var(--border);
    }

    .nav {
      max-width: 1180px;
      margin: auto;
      min-height: 72px;
      padding: 0 24px;

      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 25px;
    }

    .logo {
      font-size: 25px;
      font-weight: 900;
      letter-spacing: -1px;
    }

    .logo span {
      color: var(--accent);
    }

    .nav-links {
      display: flex;
      gap: 30px;
      align-items: center;
      font-size: 14px;
      font-weight: 600;
      color: #424b57;
    }

    .nav-links a:hover {
      color: var(--accent);
    }

    .call-button {
      background: var(--accent);
      color: white;
      padding: 11px 18px;
      border-radius: 5px;
      font-size: 14px;
      font-weight: 800;
      white-space: nowrap;
    }

    .call-button:hover {
      background: var(--accent-dark);
    }

    /* =========================
       HERO
    ========================= */

    .hero {
      min-height: 680px;

      background:
        linear-gradient(
          90deg,
          rgba(8, 14, 22, 0.94) 0%,
          rgba(8, 14, 22, 0.78) 48%,
          rgba(8, 14, 22, 0.35) 100%
        ),
        url("https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?auto=format&fit=crop&w=1900&q=85")
        center / cover no-repeat;

      display: flex;
      align-items: center;
    }

    .hero-container {
      width: 100%;
      max-width: 1180px;
      margin: auto;
      padding: 80px 24px;

      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      align-items: center;
      gap: 70px;
    }

    .hero-content {
      color: white;
    }

    .eyebrow {
      display: inline-block;
      color: #ffb5ba;
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 1.6px;
      text-transform: uppercase;
      margin-bottom: 17px;
    }

    .hero h1 {
      font-size: clamp(42px, 5vw, 65px);
      line-height: 1.04;
      letter-spacing: -2.5px;
      margin-bottom: 22px;
    }

    .hero-description {
      max-width: 610px;
      color: rgba(255,255,255,0.87);
      font-size: 18px;
      margin-bottom: 30px;
    }

    .hero-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 13px;
    }

    .button {
      display: inline-flex;
      justify-content: center;
      align-items: center;

      min-height: 50px;
      padding: 0 23px;

      border-radius: 5px;
      font-weight: 800;
      font-size: 15px;

      transition: 0.2s ease;
    }

    .button-primary {
      background: var(--accent);
      color: white;
    }

    .button-primary:hover {
      background: var(--accent-dark);
      transform: translateY(-1px);
    }

    .button-outline {
      color: white;
      border: 1px solid rgba(255,255,255,0.7);
    }

    .button-outline:hover {
      background: white;
      color: var(--primary);
    }

    /* =========================
       LEAD FORM
    ========================= */

    .lead-card {
      background: white;
      border-radius: 9px;
      padding: 31px;

      box-shadow:
        0 25px 70px rgba(0,0,0,0.27);
    }

    .lead-card h2 {
      font-size: 27px;
      line-height: 1.2;
      margin-bottom: 8px;
    }

    .lead-card-description {
      color: var(--text);
      font-size: 14px;
      margin-bottom: 22px;
    }

    .form-group {
      margin-bottom: 14px;
    }

    .form-group label {
      display: block;
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 6px;
    }

    .form-group input,
    .form-group select {
      width: 100%;
      height: 46px;
      padding: 0 13px;

      border: 1px solid #d5d9df;
      border-radius: 5px;

      background: white;
      font-family: inherit;
      font-size: 14px;
      color: #222;
      outline: none;
    }

    .form-group input:focus,
    .form-group select:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(230,57,70,0.08);
    }

    .submit-button {
      width: 100%;
      height: 49px;

      border: 0;
      border-radius: 5px;

      background: var(--accent);
      color: white;

      font-size: 15px;
      font-weight: 800;

      cursor: pointer;
    }

    .submit-button:hover {
      background: var(--accent-dark);
    }

    .form-disclaimer {
      color: #858d96;
      font-size: 10.5px;
      line-height: 1.5;
      text-align: center;
      margin-top: 11px;
    }

    /* =========================
       TRUST BAR
    ========================= */

    .trust-bar {
      border-bottom: 1px solid var(--border);
      background: white;
    }

    .trust-container {
      max-width: 1180px;
      margin: auto;
      padding: 25px 24px;

      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
    }

    .trust-item {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      text-align: center;
    }

    .trust-icon {
      width: 38px;
      height: 38px;
      flex-shrink: 0;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 50%;
      background: #fff0f1;
      color: var(--accent);

      font-weight: 900;
    }

    .trust-item strong {
      display: block;
      font-size: 14px;
    }

    .trust-item span {
      display: block;
      font-size: 12px;
      color: var(--text);
    }

    /* =========================
       VEHICLE TYPES
    ========================= */

    section {
      padding: 85px 24px;
    }

    .container {
      max-width: 1180px;
      margin: auto;
    }

    .section-heading {
      max-width: 700px;
      margin: 0 auto 48px;
      text-align: center;
    }

    .section-heading .eyebrow {
      color: var(--accent);
      margin-bottom: 9px;
    }

    .section-heading h2 {
      font-size: 38px;
      line-height: 1.2;
      margin-bottom: 13px;
    }

    .section-heading p {
      color: var(--text);
    }

    .vehicles {
      background: var(--light);
    }

    .vehicle-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 23px;
    }

    .vehicle-card {
      overflow: hidden;
      border-radius: 8px;
      background: white;
      border: 1px solid var(--border);
    }

    .vehicle-image {
      height: 210px;
      overflow: hidden;
    }

    .vehicle-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s ease;
    }

    .vehicle-card:hover .vehicle-image img {
      transform: scale(1.04);
    }

    .vehicle-content {
      padding: 23px;
    }

    .vehicle-content h3 {
      font-size: 20px;
      margin-bottom: 7px;
    }

    .vehicle-content p {
      color: var(--text);
      font-size: 14px;
    }

    /* =========================
       BENEFITS
    ========================= */

    .benefit-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
    }

    .benefit-card {
      padding: 31px;
      border: 1px solid var(--border);
      border-radius: 8px;
    }

    .benefit-number {
      font-size: 12px;
      font-weight: 900;
      color: var(--accent);
      letter-spacing: 1px;
      margin-bottom: 13px;
    }

    .benefit-card h3 {
      font-size: 20px;
      margin-bottom: 9px;
    }

    .benefit-card p {
      color: var(--text);
      font-size: 14px;
    }

    /* =========================
       PROCESS
    ========================= */

    .process {
      background: var(--light);
    }

    .process-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 35px;
    }

    .process-card {
      text-align: center;
    }

    .process-number {
      width: 54px;
      height: 54px;

      margin: 0 auto 18px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 50%;
      background: var(--primary);
      color: white;

      font-size: 18px;
      font-weight: 900;
    }

    .process-card h3 {
      font-size: 18px;
      margin-bottom: 8px;
    }

    .process-card p {
      color: var(--text);
      font-size: 14px;
    }

    /* =========================
       CTA
    ========================= */

    .cta {
      background: var(--primary);
      color: white;
      text-align: center;
    }

    .cta h2 {
      font-size: 40px;
      line-height: 1.2;
      margin-bottom: 13px;
    }

    .cta p {
      max-width: 650px;
      margin: 0 auto 27px;
      color: rgba(255,255,255,0.78);
    }

    /* =========================
       FOOTER
    ========================= */

    footer {
      background: #0b1118;
      color: rgba(255,255,255,0.65);
      padding: 45px 24px 22px;
    }

    .footer-grid {
      max-width: 1180px;
      margin: auto;

      display: grid;
      grid-template-columns: 1.5fr 1fr 1fr;
      gap: 40px;

      padding-bottom: 32px;
    }

    footer h3 {
      color: white;
      margin-bottom: 12px;
      font-size: 18px;
    }

    footer p,
    footer a {
      font-size: 13px;
    }

    footer a:hover {
      color: white;
    }

    .footer-bottom {
      max-width: 1180px;
      margin: auto;
      padding-top: 19px;

      border-top: 1px solid rgba(255,255,255,0.1);

      text-align: center;
      font-size: 11px;
    }

    /* =========================
       MOBILE
    ========================= */

    @media (max-width: 850px) {

      .nav-links {
        display: none;
      }

      .hero {
        min-height: auto;
      }

      .hero-container {
        grid-template-columns: 1fr;
        padding-top: 60px;
        padding-bottom: 60px;
        gap: 40px;
      }

      .hero h1 {
        font-size: 45px;
      }

      .vehicle-grid,
      .benefit-grid,
      .process-grid {
        grid-template-columns: 1fr;
      }

      .trust-container {
        grid-template-columns: 1fr;
      }

      .footer-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 500px) {

      .nav {
        min-height: 65px;
        padding: 0 15px;
      }

      .logo {
        font-size: 20px;
      }

      .call-button {
        padding: 9px 11px;
        font-size: 12px;
      }

      .hero-container {
        padding: 50px 18px;
      }

      .hero h1 {
        font-size: 38px;
        letter-spacing: -1.5px;
      }

      .hero-description {
        font-size: 16px;
      }

      .lead-card {
        padding: 23px 19px;
      }

      section {
        padding: 65px 18px;
      }

      .section-heading h2,
      .cta h2 {
        font-size: 30px;
      }
    }
  </style>
</head>

