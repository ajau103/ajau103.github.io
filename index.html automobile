  <script>

    /*
      Demo form behavior.

      Before running Google Ads, connect this form
      to your actual CRM, backend, or lead-processing
      service so submitted leads are stored.
    */

    const form = document.getElementById("vehicleForm");

    form.addEventListener("submit", function(event) {

      event.preventDefault();

      const button = form.querySelector(".submit-button");

      button.textContent = "Thank You!";
      button.disabled = true;

      setTimeout(function() {

        alert(
          "Thank you for your request. Please connect this form to your lead system before launching your campaign."
        );

        form.reset();

        button.textContent = "Request Information";
        button.disabled = false;

      }, 500);

    });

